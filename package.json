{
  "name": "questclass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @questclass/api --filter @questclass/web dev",
    "build": "corepack pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "corepack pnpm build && corepack pnpm --filter @questclass/e2e test",
    "e2e:docker": "node e2e/docker.mjs",
    "e2e:update": "node e2e/docker.mjs --update-snapshots=all",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input && prettier --check \"**/*.{ts,tsx,mts,mjs,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,css}\"",
    "typecheck": "corepack pnpm -r typecheck",
    "db:generate": "corepack pnpm --filter @questclass/api db:generate",
    "assets:import": "node scripts/assets/import.mjs",
    "assets:budget": "node scripts/assets/budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
